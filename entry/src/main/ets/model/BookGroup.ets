import { Book } from './Book';

/** 书籍分组（纯数据）。一本书最多属于一个分组。 */
export class BookGroup {
  id: number = 0;
  name: string = '';
  /** 越小越靠前 */
  sortOrder: number = 0;
  createdAt: number = 0;
  updatedAt: number = 0;
  deleted: number = 0;

  /** 分组 + 该组书籍数，供分组管理页显示 */
  bookCount: number = 0;

  /**
   * 组内**前几本**书（最多 `AppConstants.GROUP_COVER_SLOTS` 本），
   * 供分组封面渲染。
   *
   * ⚠️ 分组封面是"**用组内书的封面填格子**"（用户明确要求）：
   * 有几本填几格，填满 4 格后**不再变化** —— 所以只需要前 4 本，
   * 不必把整个组加载进内存。
   *
   * ⚠️ 数量由 `bookCount` 表达、封面内容由本字段表达，两者**都要**：
   * 只有数量就画不出封面，只有封面就显示不了"共几本"。
   */
  coverBooks: Book[] = [];

  // ------------------------------------------------------------ 排序用
  /**
   * 组内**最近一次阅读时间**（取组内各书 `lastReadAt` 的最大值）；
   * `null` 表示组内没有任何书被读过。
   *
   * ⚠️ 分组在书架首页里**就相当于一本书**（用户明确要求），
   * 所以它必须能参与"最近阅读"排序 —— 没有这个字段，
   * 分组就只能被永远排在书的前面或后面，做不到真正的混排
   * （用户实测反馈：刚读完的书应当排在最前，而不是被分组挤到下面）。
   *
   * ⚠️ 取**组内最大值**而不是分组自身的创建时间：
   * "最近阅读"问的是"这个分组里最近在读什么"，
   * 用创建时间会让一个刚建但没人读的组排在最前面，与直觉相反。
   */
  lastReadAt: number | null = null;

  /**
   * 组内**最新导入时间**（取组内各书 `addedAt` 的最大值；
   * 组里没书时退回分组自身的创建时间）。
   *
   * ⚠️ 组里没书时**必须**有值：否则空分组在"导入时间"排序下
   * 会因为 0 而被排到最后 —— 而用户刚建好的组理应看得见。
   */
  addedAt: number = 0;
}
